{
  "permissions": {
    "allow": [
      "Bash(gh api -X PUT repos/yassineennassiri/italiano/pulls/*/merge -f merge_method=squash)",
      "Bash(gh api -X PUT $R/pulls/*/merge -f merge_method=squash)",
      "Bash(gh pr merge * --squash --delete-branch)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/cloud-session-start.mjs",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
