# Copy this file to .env.local and fill in both values. Never commit .env.local.
# Get the connection strings from the Neon console: Connect, pick the branch,
# and copy the connection string (the app uses Neon's HTTP driver, ADR-0001).

# Neon `main` branch: your real progress. Used by `npm run dev`, db:migrate and db:seed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Neon `dev` branch: experiments, Playwright runs and the database tests.
# Used by `npm test` and by db:migrate / db:seed with `-- --test`.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
